cat > /mnt/user-data/outputs/prior-auth-simulator.html << 'HTMLEOF'
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Prior Authorization Workflow Simulator</title>
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --blue-50: #e6f1fb;
  --blue-100: #b5d4f4;
  --blue-200: #85b7eb;
  --blue-400: #378add;
  --blue-600: #185fa5;
  --blue-800: #0c447c;
  --blue-900: #042c53;
  --green-50: #eaf3de;
  --green-400: #639922;
  --green-600: #3b6d11;
  --amber-50: #faeeda;
  --amber-400: #ba7517;
  --amber-600: #854f0b;
  --red-50: #fcebeb;
  --red-400: #e24b4a;
  --red-600: #a32d2d;
  --gray-50: #f5f7fa;
  --gray-100: #e8ecf2;
  --gray-200: #d0d7e3;
  --gray-400: #8896a8;
  --gray-600: #4a5568;
  --gray-800: #1a2535;
  --radius: 8px;
  --shadow: 0 2px 8px rgba(0,0,0,0.08), 0 1px 3px rgba(0,0,0,0.05);
  --shadow-lg: 0 8px 24px rgba(0,0,0,0.12), 0 2px 8px rgba(0,0,0,0.06);
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  background: var(--gray-50);
  color: var(--gray-800);
  min-height: 100vh;
  font-size: 14px;
  line-height: 1.5;
}

#app-header {
  background: var(--blue-800);
  color: #fff;
  padding: 14px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: var(--shadow);
}
#app-header h1 { font-size: 18px; font-weight: 600; letter-spacing: -0.3px; }
#app-header .subtitle { font-size: 12px; opacity: 0.75; margin-top: 2px; }
#header-right { display: flex; align-items: center; gap: 12px; }

#stats-bar {
  background: var(--blue-900);
  color: #fff;
  padding: 8px 24px;
  display: flex;
  gap: 28px;
  font-size: 12px;
  flex-wrap: wrap;
}
.stat-item { display: flex; align-items: center; gap: 6px; }
.stat-label { opacity: 0.65; }
.stat-value { font-weight: 700; font-size: 13px; color: #93c5fd; }

#progress-tracker {
  background: #fff;
  border-bottom: 1px solid var(--gray-200);
  padding: 12px 24px;
  overflow-x: auto;
}
.progress-steps {
  display: flex;
  align-items: center;
  gap: 0;
  min-width: 600px;
}
.progress-step {
  display: flex;
  align-items: center;
  flex: 1;
  position: relative;
}
.step-dot {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 2px solid var(--gray-200);
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  font-weight: 700;
  color: var(--gray-400);
  flex-shrink: 0;
  transition: all 0.3s;
  z-index: 2;
  position: relative;
}
.step-dot.active {
  border-color: var(--blue-400);
  background: var(--blue-50);
  color: var(--blue-600);
}
.step-dot.done {
  border-color: var(--green-400);
  background: var(--green-400);
  color: #fff;
}
.step-connector {
  flex: 1;
  height: 2px;
  background: var(--gray-200);
  margin: 0 4px;
  transition: background 0.3s;
}
.step-connector.done { background: var(--green-400); }
.step-label {
  position: absolute;
  top: 32px;
  left: 50%;
  transform: translateX(-50%);
  font-size: 10px;
  white-space: nowrap;
  color: var(--gray-400);
  font-weight: 500;
}
.step-label.active { color: var(--blue-600); }
.step-label.done { color: var(--green-600); }
.progress-steps-wrap { padding-bottom: 22px; }

#main { padding: 20px 24px; }
.scenario-selector {
  background: #fff;
  border: 1px solid var(--gray-200);
  border-radius: var(--radius);
  padding: 16px 20px;
  margin-bottom: 20px;
  box-shadow: var(--shadow);
}
.scenario-selector h2 { font-size: 15px; font-weight: 600; margin-bottom: 10px; color: var(--blue-800); }
.scenario-pills { display: flex; gap: 8px; flex-wrap: wrap; }
.pill {
  padding: 6px 14px;
  border-radius: 20px;
  border: 1.5px solid var(--blue-200);
  background: var(--blue-50);
  color: var(--blue-800);
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
}
.pill:hover { background: var(--blue-200); }
.pill.selected { background: var(--blue-600); color: #fff; border-color: var(--blue-600); }

#lanes-wrap {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16px;
  margin-bottom: 20px;
}
.lane {
  background: #fff;
  border: 1.5px solid var(--gray-200);
  border-radius: 12px;
  box-shadow: var(--shadow);
  overflow: hidden;
}
.lane-header {
  padding: 12px 16px;
  font-weight: 700;
  font-size: 13px;
  display: flex;
  align-items: center;
  gap: 8px;
  border-bottom: 1.5px solid var(--gray-200);
}
.lane-icon {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
}
.lane-patient .lane-header { background: var(--blue-50); color: var(--blue-900); }
.lane-patient .lane-icon { background: var(--blue-200); }
.lane-provider .lane-header { background: #e8f5e9; color: #1b5e20; }
.lane-provider .lane-icon { background: #c8e6c9; }
.lane-payer .lane-header { background: #fff3e0; color: #e65100; }
.lane-payer .lane-icon { background: #ffe0b2; }

.lane-body {
  padding: 12px;
  min-height: 200px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.lane-body.drag-over {
  background: var(--blue-50);
  outline: 2px dashed var(--blue-400);
  outline-offset: -4px;
  border-radius: 4px;
}

.case-card {
  background: #fff;
  border: 1.5px solid var(--gray-200);
  border-radius: var(--radius);
  padding: 12px 14px;
  cursor: grab;
  box-shadow: var(--shadow);
  transition: box-shadow 0.2s, transform 0.1s, border-color 0.2s;
  user-select: none;
  position: relative;
}
.case-card:hover { box-shadow: var(--shadow-lg); border-color: var(--blue-200); transform: translateY(-1px); }
.case-card.dragging { opacity: 0.45; transform: scale(0.97); cursor: grabbing; }
.case-card.ghost {
  border: 2px dashed var(--blue-400);
  background: var(--blue-50);
  opacity: 0.7;
}
.case-title { font-weight: 700; font-size: 13px; color: var(--blue-800); margin-bottom: 4px; }
.case-stage-badge {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 12px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.3px;
  margin-bottom: 6px;
}
.badge-intake { background: var(--blue-50); color: var(--blue-600); border: 1px solid var(--blue-200); }
.badge-necessity { background: #e8f5e9; color: #1b5e20; border: 1px solid #a5d6a7; }
.badge-docs { background: #fff3e0; color: #e65100; border: 1px solid #ffcc80; }
.badge-submitted { background: #e3f2fd; color: #0d47a1; border: 1px solid #90caf9; }
.badge-review { background: #f3e5f5; color: #4a148c; border: 1px solid #ce93d8; }
.badge-approved { background: var(--green-50); color: var(--green-600); border: 1px solid #a5d6a7; }
.badge-denied { background: var(--red-50); color: var(--red-600); border: 1px solid #ef9a9a; }
.badge-pended { background: #fff8e1; color: #f57f17; border: 1px solid #ffe082; }
.badge-appeal { background: #fce4ec; color: #880e4f; border: 1px solid #f48fb1; }
.badge-p2p { background: #e8eaf6; color: #1a237e; border: 1px solid #9fa8da; }
.case-info { font-size: 11px; color: var(--gray-600); margin-bottom: 8px; }
.case-info span { display: inline-block; margin-right: 10px; }

.case-actions { display: flex; gap: 6px; flex-wrap: wrap; }
.btn {
  padding: 5px 11px;
  border-radius: 6px;
  border: 1.5px solid;
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.15s;
  letter-spacing: 0.2px;
}
.btn:hover { filter: brightness(0.92); transform: translateY(-1px); }
.btn:active { transform: scale(0.97); }
.btn-primary { background: var(--blue-600); color: #fff; border-color: var(--blue-600); }
.btn-success { background: var(--green-400); color: #fff; border-color: var(--green-400); }
.btn-warning { background: #f57f17; color: #fff; border-color: #f57f17; }
.btn-danger { background: var(--red-400); color: #fff; border-color: var(--red-400); }
.btn-secondary { background: #fff; color: var(--gray-800); border-color: var(--gray-200); }
.btn-outline { background: transparent; color: var(--blue-600); border-color: var(--blue-400); }
.btn-sm { padding: 3px 8px; font-size: 10px; }

#edu-panel {
  background: var(--blue-50);
  border: 1.5px solid var(--blue-200);
  border-radius: 12px;
  padding: 16px 20px;
  margin-bottom: 20px;
  box-shadow: var(--shadow);
  transition: all 0.3s;
}
#edu-panel h3 { font-size: 14px; font-weight: 700; color: var(--blue-800); margin-bottom: 8px; display: flex; align-items: center; gap: 8px; }
#edu-panel p { font-size: 13px; color: var(--blue-900); line-height: 1.6; }
.edu-icon { font-size: 18px; }

#modal-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  z-index: 200;
  align-items: center;
  justify-content: center;
}
#modal-overlay.show { display: flex; }
#modal {
  background: #fff;
  border-radius: 16px;
  padding: 28px 32px;
  max-width: 500px;
  width: 90%;
  box-shadow: var(--shadow-lg);
  position: relative;
  animation: popIn 0.25s cubic-bezier(0.34,1.56,0.64,1);
}
@keyframes popIn {
  from { opacity: 0; transform: scale(0.85); }
  to { opacity: 1; transform: scale(1); }
}
#modal h2 { font-size: 20px; font-weight: 700; margin-bottom: 8px; }
#modal .modal-body { font-size: 13px; line-height: 1.7; color: var(--gray-600); margin-bottom: 20px; }
#modal-close {
  position: absolute;
  top: 14px; right: 16px;
  background: none; border: none;
  font-size: 20px; cursor: pointer;
  color: var(--gray-400);
  line-height: 1;
}
#modal-close:hover { color: var(--gray-800); }
.modal-actions { display: flex; gap: 10px; flex-wrap: wrap; }

#confetti-canvas {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 300;
}

#summary-panel {
  display: none;
  background: #fff;
  border: 2px solid var(--green-400);
  border-radius: 12px;
  padding: 24px 28px;
  margin-bottom: 20px;
  box-shadow: var(--shadow-lg);
}
#summary-panel h2 { color: var(--green-600); font-size: 18px; margin-bottom: 16px; }
.summary-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 16px; }
.summary-stat {
  background: var(--gray-50);
  border-radius: var(--radius);
  padding: 12px 14px;
  text-align: center;
}
.summary-stat .s-label { font-size: 11px; color: var(--gray-400); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
.summary-stat .s-value { font-size: 24px; font-weight: 800; color: var(--blue-800); margin-top: 4px; }
.summary-log { margin-top: 12px; }
.summary-log h3 { font-size: 13px; font-weight: 700; color: var(--gray-600); margin-bottom: 8px; }
.log-item { display: flex; gap: 10px; align-items: flex-start; font-size: 12px; padding: 5px 0; border-bottom: 1px solid var(--gray-100); }
.log-dot { width: 8px; height: 8px; border-radius: 50%; margin-top: 4px; flex-shrink: 0; }
.log-text { color: var(--gray-600); }
.log-time { color: var(--gray-400); white-space: nowrap; margin-left: auto; }

#btn-restart {
  padding: 8px 18px;
  background: transparent;
  color: #fff;
  border: 1.5px solid rgba(255,255,255,0.5);
  border-radius: 8px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
}
#btn-restart:hover { background: rgba(255,255,255,0.15); border-color: #fff; }

.drag-hint {
  color: var(--gray-400);
  font-size: 11px;
  text-align: center;
  padding: 20px 0 8px;
  font-style: italic;
}

.checklist { list-style: none; margin-top: 6px; }
.checklist li {
  font-size: 11px;
  color: var(--gray-600);
  padding: 2px 0;
  display: flex;
  align-items: center;
  gap: 5px;
}
.check-icon { font-size: 12px; }
.check-done { color: var(--green-400); }
.check-pending { color: var(--gray-400); }

@media (max-width: 700px) {
  #lanes-wrap { grid-template-columns: 1fr; }
  #app-header h1 { font-size: 15px; }
  #stats-bar { gap: 14px; }
}
</style>
</head>
<body>

<header id="app-header">
  <div>
    <h1>🏥 Prior Authorization Workflow Simulator</h1>
    <div class="subtitle">Interactive US Healthcare PA Training &amp; Education</div>
  </div>
  <div id="header-right">
    <button id="btn-restart" onclick="restartGame()">&#8635; New Patient</button>
  </div>
</header>

<div id="stats-bar">
  <div class="stat-item">
    <span class="stat-label">Days Elapsed:</span>
    <span class="stat-value" id="stat-days">0</span>
  </div>
  <div class="stat-item">
    <span class="stat-label">Efficiency Score:</span>
    <span class="stat-value" id="stat-score">100</span>
  </div>
  <div class="stat-item">
    <span class="stat-label">Steps Completed:</span>
    <span class="stat-value" id="stat-steps">0 / 0</span>
  </div>
  <div class="stat-item">
    <span class="stat-label">Current Stage:</span>
    <span class="stat-value" id="stat-stage">—</span>
  </div>
  <div class="stat-item">
    <span class="stat-label">Scenario:</span>
    <span class="stat-value" id="stat-scenario">None</span>
  </div>
</div>

<div id="progress-tracker">
  <div class="progress-steps-wrap">
    <div class="progress-steps" id="progress-steps"></div>
  </div>
</div>

<main id="main">

  <div class="scenario-selector">
    <h2>&#128203; Select a Patient Scenario to Begin</h2>
    <div class="scenario-pills" id="scenario-pills"></div>
  </div>

  <div id="edu-panel">
    <h3><span class="edu-icon">&#128218;</span> Welcome to the PA Simulator</h3>
    <p>Prior Authorization (PA) is a cost-control process used by health insurers requiring providers to obtain approval before delivering certain services. Select a scenario above, then follow the workflow steps. Drag cards between lanes or use the action buttons. Every action teaches you about the real-world PA process.</p>
  </div>

  <div id="summary-panel">
    <h2>&#127881; Workflow Complete!</h2>
    <div class="summary-grid" id="summary-grid"></div>
    <div class="summary-log">
      <h3>Activity Log</h3>
      <div id="summary-log-list"></div>
    </div>
    <div style="margin-top:16px;">
      <button class="btn btn-primary" onclick="restartGame()">Start Another Case</button>
    </div>
  </div>

  <div id="lanes-wrap">
    <div class="lane lane-patient" id="lane-patient">
      <div class="lane-header">
        <div class="lane-icon">👤</div>
        Patient
      </div>
      <div class="lane-body" id="lane-body-patient"
           ondragover="handleDragOver(event,'patient')"
           ondragleave="handleDragLeave(event,'patient')"
           ondrop="handleDrop(event,'patient')">
        <div class="drag-hint">Cases in patient's court appear here</div>
      </div>
    </div>

    <div class="lane lane-provider" id="lane-provider">
      <div class="lane-header">
        <div class="lane-icon">🩺</div>
        Provider / Office
      </div>
      <div class="lane-body" id="lane-body-provider"
           ondragover="handleDragOver(event,'provider')"
           ondragleave="handleDragLeave(event,'provider')"
           ondrop="handleDrop(event,'provider')">
        <div class="drag-hint">Start here — drag case from Patient lane</div>
      </div>
    </div>

    <div class="lane lane-payer" id="lane-payer">
      <div class="lane-header">
        <div class="lane-icon">🏢</div>
        Payer / Insurance
      </div>
      <div class="lane-body" id="lane-body-payer"
           ondragover="handleDragOver(event,'payer')"
           ondragleave="handleDragLeave(event,'payer')"
           ondrop="handleDrop(event,'payer')">
        <div class="drag-hint">Submitted cases and decisions appear here</div>
      </div>
    </div>
  </div>

</main>

<div id="modal-overlay">
  <div id="modal">
    <button id="modal-close" onclick="closeModal()" aria-label="Close">&#x2715;</button>
    <h2 id="modal-title"></h2>
    <div class="modal-body" id="modal-body"></div>
    <div class="modal-actions" id="modal-actions"></div>
  </div>
</div>

<canvas id="confetti-canvas"></canvas>

<script>
const SCENARIOS = [
  {
    id: 'elective-surgery',
    name: 'Elective Surgery',
    emoji: '🔪',
    serviceType: 'Laparoscopic Cholecystectomy',
    diagnosisCode: 'K80.20 (Cholelithiasis)',
    insurancePlan: 'Blue Shield PPO',
    urgency: 'Routine',
    baseApprovalChance: 0.72,
    requiredDocs: ['Physician referral letter', 'Imaging reports (ultrasound)', 'Failed conservative treatment notes', 'Surgical consent form'],
    necessityFactors: ['Recurrent biliary colic', 'Documented stones on ultrasound', 'Pain affecting daily function', 'Failed dietary management'],
    education: {
      intake: 'Elective surgeries almost always require Prior Authorization. The payer wants evidence the procedure is medically necessary and that conservative options have been exhausted.',
      necessity: 'Medical necessity for elective surgery means: (1) the condition is documented by objective findings, (2) the procedure is standard of care, and (3) less invasive alternatives have been tried.',
      docs: 'For surgical PAs, payers typically require imaging, failed conservative treatment documentation, and a detailed letter of medical necessity from the surgeon.',
      submitted: 'Once submitted, payers typically have 5–14 business days for non-urgent surgical PAs under federal and state regulations.',
      review: 'The payer\'s clinical review team — often an RN or physician — evaluates the submission against evidence-based criteria (InterQual, MCG, etc.).',
      approved: 'Authorization granted! The patient can schedule surgery. Note: PA approval does not guarantee payment — the claim still undergoes separate adjudication.',
      denied: 'Denial may be due to missing documentation or criteria not met. The provider has appeal rights under state law, usually 60–180 days to file.',
      appeal: 'Internal appeals involve re-submission with additional clinical support. External appeals can be requested if internal appeal fails.',
      p2p: 'Peer-to-Peer (P2P) review is a physician-to-physician call where the treating doctor speaks directly with the payer\'s medical director to advocate for the patient.',
    }
  },
  {
    id: 'mri',
    name: 'MRI Scan',
    emoji: '🧲',
    serviceType: 'Brain MRI w/ & w/o contrast',
    diagnosisCode: 'G43.909 (Migraine, unspecified)',
    insurancePlan: 'Aetna HMO',
    urgency: 'Semi-urgent',
    baseApprovalChance: 0.80,
    requiredDocs: ['Neurology consultation note', 'Symptom diary / headache log', 'Failed medication trials', 'Red flag symptom checklist'],
    necessityFactors: ['New or changed headache pattern', 'Neurological symptoms present', 'First severe "thunderclap" headache', 'Failed 2+ migraine medications'],
    education: {
      intake: 'Diagnostic imaging (MRI, CT) frequently requires PA, especially for advanced imaging. Payers use "appropriateness criteria" to ensure imaging is justified.',
      necessity: 'For brain MRI, AIM Specialty Health or similar radiology benefit managers evaluate whether "red flag" symptoms are present that warrant advanced imaging vs. clinical observation.',
      docs: 'Key documents: the ordering physician\'s clinical notes documenting symptoms, chronology, and what treatments have been tried. The specific CPT code matters — MRI with vs. without contrast can have different criteria.',
      submitted: 'Radiology PAs can be processed quickly (24–72 hours) through automated portals or Real-Time PA programs. Semi-urgent cases may qualify for expedited review (72 hours vs. 14 days).',
      review: 'Radiology benefit managers (RBMs) like AIM, eviCore, or Carelon often handle imaging PAs separately from the main payer. They apply ACR Appropriateness Criteria.',
      approved: 'MRI authorized! The facility and date must be within the authorized window (typically 60–90 days). Using an in-network facility is critical to avoid balance billing.',
      denied: 'MRI denials often cite "not meeting imaging criteria" — usually because conservative management wasn\'t documented. A P2P call is often very effective here.',
      appeal: 'For imaging, appeals with supplementary clinical notes often succeed. If neurological red flags exist, document them explicitly and cite AHA/AAN guidelines.',
      p2p: 'Radiologists or ordering physicians can request P2P with the RBM\'s physician. Having the clinical rationale and relevant guideline citations ready is critical.',
    }
  },
  {
    id: 'specialty-med',
    name: 'Specialty Medication',
    emoji: '💊',
    serviceType: 'Adalimumab (Humira) — 40mg SQ biweekly',
    diagnosisCode: 'M05.79 (Rheumatoid Arthritis)',
    insurancePlan: 'United Healthcare Choice Plus',
    urgency: 'Routine',
    baseApprovalChance: 0.65,
    requiredDocs: ['Rheumatologist treatment notes', 'Failed DMARD therapy documentation', 'Lab results (CRP, ESR, RF)', 'Step therapy compliance record'],
    necessityFactors: ['Active RA with moderate-severe disease', 'Failed 2+ conventional DMARDs', 'Abnormal inflammatory markers', 'Functional impairment documented'],
    education: {
      intake: 'Specialty biologics costing $20,000–$80,000/year are among the most heavily PA-controlled drugs. Payers require proof of step therapy — trying cheaper drugs first.',
      necessity: 'For biologics, payers apply "step therapy" protocols. For Humira, the patient must typically have tried and failed methotrexate, hydroxychloroquine, or sulfasalazine.',
      docs: 'Specialty pharmacy PAs require detailed treatment history showing prior therapy failures, current labs, and the prescriber\'s attestation that the criteria are met.',
      submitted: 'Specialty pharmacy PAs often go through Pharmacy Benefit Managers (PBMs) like Express Scripts, CVS Caremark, or OptumRx — separate from the medical payer.',
      review: 'The PBM\'s clinical pharmacist reviews the case. Step therapy exceptions can be requested if the patient has a medical reason they cannot use the preferred drug.',
