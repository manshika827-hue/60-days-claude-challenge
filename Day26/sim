const WORKFLOW_STAGES = [
  { id: 'intake',     label: 'Intake',       lane: 'patient',   day: 0  },
  { id: 'necessity',  label: 'Med Necessity', lane: 'provider',  day: 1  },
  { id: 'docs',       label: 'Docs',          lane: 'provider',  day: 2  },
  { id: 'submitted',  label: 'Submitted',     lane: 'payer',     day: 3  },
  { id: 'review',     label: 'Under Review',  lane: 'payer',     day: 5  },
  { id: 'outcome',    label: 'Decision',      lane: 'payer',     day: 8  },
  { id: 'done',       label: 'Complete',      lane: 'patient',   day: 9  },
];

let state = {
  scenario: null,
  stage: null,
  days: 0,
  score: 100,
  stepsCompleted: 0,
  totalSteps: 7,
  docsCollected: [],
  necessityFactorsMet: [],
  outcome: null,
  activityLog: [],
  dragCard: null,
  caseId: 'PA-' + Math.floor(Math.random()*90000+10000),
};

const STAGE_EDU = {
  intake:    { icon:'📋', title:'Stage 1 — Patient Intake', text:'The PA process begins when a patient or provider identifies that a service requires authorization. The office verifies insurance benefits and checks the plan\'s PA requirement list. Getting this right early prevents delays later.' },
  necessity: { icon:'🔬', title:'Stage 2 — Medical Necessity Evaluation', text:'The provider gathers clinical evidence to demonstrate that the requested service is medically necessary — meaning it is appropriate, evidence-based, and not more expensive than alternatives. Weak documentation here is the #1 cause of denials.' },
  docs:      { icon:'📂', title:'Stage 3 — Document Collection', text:'Complete, organized documentation is critical. Missing a single required document can delay authorization by days or result in denial. Most payers have specific cover sheets and clinical templates.' },
  submitted: { icon:'📤', title:'Stage 4 — Submission to Payer', text:'The PA request is submitted via fax, phone, portal (NaviNet, Availity), or increasingly via real-time PA APIs. Federal law (21st Century Cures Act) is pushing toward electronic, real-time PA.' },
  review:    { icon:'👁', title:'Stage 5 — Payer Clinical Review', text:'A payer-employed or contracted clinical reviewer (nurse, pharmacist, or physician) evaluates the PA against evidence-based criteria. This is often the "black box" of the PA system.' },
  outcome:   { icon:'⚖️', title:'Stage 6 — Decision Point', text:'The payer issues one of several decisions: Approve, Deny, Pend (request more info), or Modify. Each outcome has specific regulatory timelines and patient/provider rights.' },
  done:      { icon:'🏁', title:'Workflow Complete', text:'The PA workflow is complete. Whether approved or denied, the case has been fully navigated. In real life, approved PAs are then attached to claims for billing. Denied PAs may be appealed through internal and external review processes.' },
};

function init() {
  renderScenarioPills();
  renderProgressTracker();
  renderLanes();
  updateStats();
  showEdu('welcome');
}

function renderScenarioPills() {
  const wrap = document.getElementById('scenario-pills');
  wrap.innerHTML = '';
  SCENARIOS.forEach(s => {
    const btn = document.createElement('button');
    btn.className = 'pill' + (state.scenario && state.scenario.id === s.id ? ' selected' : '');
    btn.textContent = s.emoji + ' ' + s.name;
    btn.onclick = () => selectScenario(s);
    wrap.appendChild(btn);
  });
}

function selectScenario(s) {
  state = {
    scenario: s,
    stage: 'intake',
    days: 0,
    score: 100,
    stepsCompleted: 1,
    totalSteps: 7,
    docsCollected: [],
    necessityFactorsMet: [],
    outcome: null,
    activityLog: [],
    dragCard: null,
    caseId: 'PA-' + Math.floor(Math.random()*90000+10000),
  };
  state.activityLog.push({ text: 'Case opened: ' + s.serviceType, day: 0, color: '#185fa5' });
  document.getElementById('summary-panel').style.display = 'none';
  renderScenarioPills();
  renderProgressTracker();
  renderLanes();
  updateStats();
  showEdu('intake');
}

function renderProgressTracker() {
  const wrap = document.getElementById('progress-steps');
  wrap.innerHTML = '';
  const stageIds = WORKFLOW_STAGES.map(s => s.id);
  const currentIdx = state.stage ? stageIds.indexOf(state.stage) : -1;

  WORKFLOW_STAGES.forEach((st, i) => {
    const isDone = i < currentIdx;
    const isActive = i === currentIdx;

    const stepDiv = document.createElement('div');
    stepDiv.className = 'progress-step';

    const dot = document.createElement('div');
    dot.className = 'step-dot' + (isDone ? ' done' : isActive ? ' active' : '');
    dot.innerHTML = isDone ? '✓' : (i + 1);

    const label = document.createElement('span');
    label.className = 'step-label' + (isDone ? ' done' : isActive ? ' active' : '');
    label.textContent = st.label;
    dot.appendChild(label);
    stepDiv.appendChild(dot);

    if (i < WORKFLOW_STAGES.length - 1) {
      const conn = document.createElement('div');
      conn.className = 'step-connector' + (isDone ? ' done' : '');
      stepDiv.appendChild(conn);
    }

    wrap.appendChild(stepDiv);
  });
}

function renderLanes() {
  clearLanes();
  if (!state.scenario) return;
  const laneMap = { intake: 'patient', necessity: 'provider', docs: 'provider', submitted: 'payer', review: 'payer', outcome: 'payer', done: 'patient' };
  const lane = laneMap[state.stage] || 'patient';
  const body = document.getElementById('lane-body-' + lane);
  if (body) {
    const hint = body.querySelector('.drag-hint');
    if (hint) hint.style.display = 'none';
    body.appendChild(buildCaseCard());
  }
}

function clearLanes() {
  ['patient','provider','payer'].forEach(l => {
    const b = document.getElementById('lane-body-' + l);
    b.innerHTML = '<div class="drag-hint">Drop here</div>';
  });
}

function buildCaseCard() {
  const s = state.scenario;
  const card = document.createElement('div');
  card.className = 'case-card';
  card.id = 'case-card';
  card.draggable = true;
  card.addEventListener('dragstart', handleDragStart);
  card.addEventListener('dragend', handleDragEnd);

  const stage = state.stage;
  const badgeClass = {
    intake:'badge-intake', necessity:'badge-necessity', docs:'badge-docs',
    submitted:'badge-submitted', review:'badge-review',
    approved:'badge-approved', denied:'badge-denied',
    pended:'badge-pended', appeal:'badge-appeal', p2p:'badge-p2p',
    done:'badge-approved'
  }[stage] || 'badge-intake';

  const stageLabel = {
    intake:'Intake', necessity:'Med. Necessity', docs:'Docs Collection',
    submitted:'Submitted', review:'Under Review',
    approved:'APPROVED', denied:'DENIED', pended:'PENDED',
    appeal:'Appeal Filed', p2p:'Peer-to-Peer', done:'Complete'
  }[stage] || stage;

  card.innerHTML = `
    <div class="case-title">${s.emoji} ${s.serviceType}</div>
    <span class="case-stage-badge ${badgeClass}">${stageLabel}</span>
    <div class="case-info">
      <span>📋 ${state.caseId}</span>
      <span>🏥 ${s.insurancePlan}</span>
    </div>
    <div class="case-info">
      <span>🔖 ${s.diagnosisCode}</span>
      <span>⚡ ${s.urgency}</span>
    </div>
  `;

  const actions = document.createElement('div');
  actions.className = 'case-actions';
  buildStageActions(stage, actions);
  card.appendChild(actions);

  return card;
}

function buildStageActions(stage, container) {
  const btns = [];

  if (stage === 'intake') {
    btns.push({ label: '📋 Verify Insurance Benefits', cls: 'btn-primary', fn: 'doVerifyBenefits' });
    btns.push({ label: '📞 Request PA Forms', cls: 'btn-outline', fn: 'doRequestForms' });
  } else if (stage === 'necessity') {
    state.scenario.necessityFactors.forEach((f, i) => {
      const met = state.necessityFactorsMet.includes(i);
      btns.push({ label: (met ? '✅ ' : '⬜ ') + f, cls: met ? 'btn-success' : 'btn-secondary', fn: 'doCheckFactor(' + i + ')' });
    });
    if (state.necessityFactorsMet.length === state.scenario.necessityFactors.length) {
      btns.push({ label: '➡️ Proceed to Documentation', cls: 'btn-primary', fn: 'advanceToStage("docs")' });
    }
  } else if (stage === 'docs') {
    state.scenario.requiredDocs.forEach((d, i) => {
      const collected = state.docsCollected.includes(i);
      btns.push({ label: (collected ? '📄✅ ' : '📄 ') + d, cls: collected ? 'btn-success btn-sm' : 'btn-secondary btn-sm', fn: 'doCollectDoc(' + i + ')' });
    });
    if (state.docsCollected.length === state.scenario.requiredDocs.length) {
      btns.push({ label: '📤 Submit PA to Payer', cls: 'btn-primary', fn: 'advanceToStage("submitted")' });
    }
  } else if (stage === 'submitted') {
    btns.push({ label: '🔍 Check Submission Status', cls: 'btn-outline', fn: 'doCheckStatus' });
    btns.push({ label: '⏩ Fast-Forward to Review', cls: 'btn-primary', fn: 'advanceToStage("review")' });
  } else if (stage === 'review') {
    btns.push({ label: '📊 Payer Reviews Clinical Criteria', cls: 'btn-outline', fn: 'doReviewInfo' });
    btns.push({ label: '⚖️ Render Decision', cls: 'btn-primary', fn: 'doRenderDecision' });
  } else if (stage === 'outcome' || ['approved','denied','pended','appeal','p2p'].includes(stage)) {
    if (state.outcome === 'approved') {
      btns.push({ label: '🎉 Confirm & Schedule Service', cls: 'btn-success', fn: 'doFinish' });
    } else if (state.outcome === 'denied') {
      btns.push({ label: '📝 File Internal Appeal', cls: 'btn-warning', fn: 'doAppeal' });
      btns.push({ label: '📞 Request Peer-to-Peer', cls: 'btn-outline', fn: 'doP2P' });
      btns.push({ label: '❌ Accept Denial', cls: 'btn-danger', fn: 'doAcceptDenial' });
    } else if (state.outcome === 'pended') {
      btns.push({ label: '📤 Submit Additional Info', cls: 'btn-primary', fn: 'doSubmitAdditional' });
    } else if (state.outcome === 'appeal') {
      btns.push({ label: '⚖️ Appeal Decision', cls: 'btn-primary', fn: 'doAppealDecision' });
    } else if (state.outcome === 'p2p') {
      btns.push({ label: '📞 Conduct P2P Call', cls: 'btn-primary', fn: 'doP2PCall' });
    } else {
      btns.push({ label: '⚖️ Render Decision', cls: 'btn-primary', fn: 'doRenderDecision' });
    }
  } else if (stage === 'done') {
    btns.push({ label: '📊 View Summary', cls: 'btn-primary', fn: 'showSummary' });
    btns.push({ label: '🔄 New Patient', cls: 'btn-secondary', fn: 'restartGame' });
  }

  btns.forEach(b => {
    const btn = document.createElement('button');
    btn.className = 'btn ' + b.cls;
    btn.innerHTML = b.label;
    btn.setAttribute('onclick', b.fn);
    container.appendChild(btn);
  });
}

function doVerifyBenefits() {
  const s = state.scenario;
  addLog('Insurance benefits verified: PA required for ' + s.serviceType, '#185fa5');
  state.days += 1;
  state.score = Math.max(0, state.score - 2);
  showModal('✅ Benefits Verified',
    `<strong>Plan:</strong> ${s.insurancePlan}<br>
     <strong>Service:</strong> ${s.serviceType}<br>
     <strong>PA Required:</strong> YES<br>
     <strong>CPT/HCPCS:</strong> See payer portal<br>
     <strong>Submission Method:</strong> Online portal / fax<br><br>
     <em>${s.urgency === 'Urgent' ? '⚡ URGENT: Same-day or 24-hour PA may be available.' : 'Standard PA timeline: 5–14 business days.'}</em>`,
    [{ label: 'Proceed to Medical Necessity →', cls: 'btn-primary', fn: () => { closeModal(); advanceToStage('necessity'); } }]
  );
}

function doRequestForms() {
  addLog('PA forms requested from payer — reference number assigned', '#185fa5');
  state.days += 1;
  updateStats();
  renderLanes();
  setEdu('📋', 'PA Forms Requested', 'The payer has assigned a tracking/reference number. Many payers now have online portals (Availity, NaviNet) or direct EHR integrations. Some still use fax — a surprisingly common practice in US healthcare due to HIPAA-compliant transmission requirements.');
}

function doCheckFactor(idx) {
  if (!state.necessityFactorsMet.includes(idx)) {
    state.necessityFactorsMet.push(idx);
    const factor = state.scenario.necessityFactors[idx];
    addLog('Medical necessity factor documented: ' + factor, '#1b5e20');
    state.days += 0.5;
    state.stepsCompleted = Math.min(state.stepsCompleted + 0.3, 2);
    updateStats();
    renderLanes();
    if (state.necessityFactorsMet.length === state.scenario.necessityFactors.length) {
      setEdu('✅', 'All Necessity Factors Documented', 'All medical necessity criteria are now documented. A strong letter of medical necessity (LMN) references clinical guidelines (AHA, ACR, etc.) and clearly links the patient\'s condition to the requested service. You may now proceed to document collection.');
    } else {
      setEdu('🔬', 'Factor Documented', `${state.necessityFactorsMet.length} of ${state.scenario.necessityFactors.length} necessity factors documented. Thorough documentation significantly improves approval rates.`);
    }
  }
}

function doCollectDoc(idx) {
  if (!state.docsCollected.includes(idx)) {
    state.docsCollected.push(idx);
    const doc = state.scenario.requiredDocs[idx];
    addLog('Document collected: ' + doc, '#e65100');
    state.days += 0.5;
    state.stepsCompleted = Math.min(state.stepsCompleted + 0.3, 3);
    updateStats();
    renderLanes();
    if (state.docsCollected.length === state.scenario.requiredDocs.length) {
      setEdu('📂', 'Documentation Complete', 'All required documents collected. The PA packet is ready for submission. Pro tip: organize documents in order — cover sheet, clinical notes, test results, support letters. Complete submissions are processed faster and denied less often.');
    } else {
      setEdu('📂', 'Document Collected', `${state.docsCollected.length} of ${state.scenario.requiredDocs.length} documents ready. Missing documents are the #1 cause of pended (delayed) PAs.`);
    }
  }
}

function doCheckStatus() {
  addLog('Submission status checked — PA under review', '#0d47a1');
  state.days += 1;
  updateStats();
  setEdu('🔍', 'Status Check', 'PA is confirmed received and assigned to a clinical reviewer. Average review times by urgency: Routine = 5–14 days, Urgent = 72 hours, Emergency = concurrent/retroactive. Real-time PA is emerging via FHIR APIs (CMS mandate under 21st Century Cures Act).');
}

function doReviewInfo() {
  addLog('Payer clinical reviewer evaluating criteria (InterQual/MCG)', '#4a148c');
  updateStats();
  showModal('🔍 Clinical Review Underway',
    `The payer's clinical review team is evaluating your submission against evidence-based criteria.<br><br>
     <strong>Review Criteria Used:</strong> ${state.scenario.id === 'mri' ? 'ACR Appropriateness Criteria / AIM' : state.scenario.id === 'specialty-med' ? 'PDL step therapy requirements' : state.scenario.id === 'inpatient' ? 'Milliman Care Guidelines (MCG)' : 'InterQual'}<br><br>
     <strong>Reviewer Type:</strong> ${state.scenario.id === 'specialty-med' ? 'Clinical Pharmacist' : state.scenario.id === 'inpatient' ? 'Licensed Behavioral Health Clinician' : 'Registered Nurse (initial); MD if non-approval'}<br><br>
     <em>Tip: Only a physician or appropriate clinical peer may issue a non-approval decision under URAC/NCQA accreditation standards.</em>`,
    [{ label: 'Proceed to Decision →', cls: 'btn-primary', fn: () => { closeModal(); doRenderDecision(); } }]
  );
}

function doRenderDecision() {
  const rand = Math.random();
  const s = state.scenario;
  const docBonus = state.docsCollected.length / s.requiredDocs.length * 0.15;
  const necBonus = state.necessityFactorsMet.length / s.necessityFactors.length * 0.10;
  const approvalChance = Math.min(0.95, s.baseApprovalChance + docBonus + necBonus);

  state.days = WORKFLOW_STAGES.find(st=>st.id==='outcome').day;
  state.stepsCompleted = 6;

  let outcome;
  if (rand < approvalChance) {
    outcome = 'approved';
  } else if (rand < approvalChance + 0.12) {
    outcome = 'pended';
  } else {
    outcome = 'denied';
  }

  state.outcome = outcome;
  state.stage = outcome;
  renderProgressTracker();
  updateStats();
  renderLanes();

  const eduMap = { approved: s.education.approved, denied: s.education.denied, pended: 'The payer has issued a pend (also called a "pend for additional information"). This is not a denial — the payer needs clarifying information before making a final decision. Respond promptly; pends often have a 10-day deadline.' };
  const iconMap = { approved:'🎉', denied:'❌', pended:'⏳' };
  const titleMap = { approved:'Authorization Approved!', denied:'Prior Authorization Denied', pended:'Case Pended — Additional Info Needed' };

  setEdu(iconMap[outcome], titleMap[outcome], eduMap[outcome] || s.education[outcome]);

  const outcomeColors = { approved:'#1b5e20', denied:'#b71c1c', pended:'#e65100' };
  addLog('Payer decision: ' + outcome.toUpperCase(), outcomeColors[outcome]);

  if (outcome === 'approved') {
    state.score = Math.min(100, state.score + 10);
    celebrate();
  } else if (outcome === 'denied') {
    state.score = Math.max(0, state.score - 15);
  }
  updateStats();
}

function doAppeal() {
  state.outcome = 'appeal';
  state.stage = 'appeal';
  state.days += 3;
  state.score = Math.max(0, state.score - 5);
  addLog('Internal appeal filed — supplementary documentation submitted', '#880e4f');
  setEdu('📝', state.scenario.education.appeal.split('.')[0], state.scenario.education.appeal);
  renderLanes();
  updateStats();
}

function doP2P() {
  state.outcome = 'p2p';
  state.stage = 'p2p';
  state.days += 2;
  addLog('Peer-to-Peer review requested', '#1a237e');
  setEdu('📞', 'Peer-to-Peer Review Requested', state.scenario.education.p2p);
  renderLanes();
  updateStats();
}

function doAcceptDenial() {
  state.stage = 'done';
  state.days += 1;
  state.score = Math.max(0, state.score - 25);
  addLog('Denial accepted — patient notified of options', '#b71c1c');
  setEdu('🏁', 'Denial Accepted', 'Even after a final denial, patients retain rights: (1) External Independent Review by a state-certified IRO, (2) Grievance with state insurance commissioner, (3) CMS complaint for Medicare/Medicaid. Never give up on a medically necessary service without exhausting all appeal options.');
  state.stepsCompleted = 7;
  renderProgressTracker();
  renderLanes();
  updateStats();
}

function doSubmitAdditional() {
  const rand = Math.random();
  state.days += 2;
  addLog('Additional information submitted to payer', '#0d47a1');
  if (rand < 0.75) {
    state.outcome = 'approved';
    state.stage = 'approved';
    state.score = Math.min(100, state.score + 5);
    addLog('Pended case approved after additional info!', '#1b5e20');
    setEdu('🎉', 'Approved After Pend!', 'Excellent! The additional information resolved the payer\'s questions. This outcome highlights why thorough initial submissions matter — pended cases add days and administrative burden for both sides.');
    celebrate();
  } else {
    state.outcome = 'denied';
    state.stage = 'denied';
    state.score = Math.max(0, state.score - 15);
    addLog('Pended case converted to denial', '#b71c1c');
    setEdu('❌', 'Converted to Denial', 'The additional info was insufficient. Denials on pended cases can often be avoided with stronger initial submissions. Consider P2P or appeal.');
  }
  renderLanes();
  updateStats();
}

function doAppealDecision() {
  const rand = Math.random();
  state.days += 5;
  addLog('Appeal decision rendered by payer', '#880e4f');
  if (rand < 0.55) {
    state.outcome = 'approved';
    state.stage = 'approved';
    state.score = Math.min(100, state.score + 8);
    addLog('Appeal SUCCESSFUL — authorization granted!', '#1b5e20');
    setEdu('🎉', 'Appeal Successful!', 'Internal appeals succeed in 30–50% of cases when additional clinical documentation is provided. This is why providers should almost always appeal denials for medically necessary care. The administrative cost is worthwhile.');
    celebrate();
  } else {
    state.outcome = 'denied';
    state.stage = 'denied';
    addLog('Appeal upheld — denial stands', '#b71c1c');
    setEdu('⚖️', 'Appeal Upheld', 'When internal appeals fail, patients/providers can request External Independent Review (IRO) within 60–180 days. State insurance commissioners can also investigate systematic denial patterns.');
  }
  renderLanes();
  updateStats();
}

function doP2PCall() {
  const rand = Math.random();
  state.days += 2;
  addLog('Peer-to-Peer call conducted with payer medical director', '#1a237e');
  if (rand < 0.68) {
    state.outcome = 'approved';
    state.stage = 'approved';
    state.score = Math.min(100, state.score + 12);
    addLog('P2P call resulted in APPROVAL — authorization overturned!', '#1b5e20');
    setEdu('📞', 'P2P Call Successful!', 'P2P reviews have high success rates (often 60–70%) because they allow direct clinical dialogue. The key: be prepared with specific clinical facts, cite applicable guidelines by name, and explain why criteria ARE met — not just what the patient needs.');
    celebrate();
  } else {
    state.outcome = 'denied';
    state.stage = 'denied';
    addLog('P2P call unsuccessful — upheld denial', '#b71c1c');
    setEdu('📞', 'P2P Unsuccessful', 'Even after P2P, appeals remain available. Document everything discussed in the P2P call — what criteria the medical director cited, what they said was missing. This information strengthens the formal appeal.');
  }
  renderLanes();
  updateStats();
}

function doFinish() {
  state.stage = 'done';
  state.stepsCompleted = 7;
  state.days += 1;
  addLog('Service scheduled and authorized — case closed', '#1b5e20');
  renderProgressTracker();
  renderLanes();
  updateStats();
  setEdu('🏁', 'Case Complete', STAGE_EDU.done.text);
  setTimeout(showSummary, 400);
}

function advanceToStage(stageId) {
  const stageObj = WORKFLOW_STAGES.find(s => s.id === stageId);
  const prevIdx = WORKFLOW_STAGES.findIndex(s => s.id === state.stage);
  const nextIdx = WORKFLOW_STAGES.findIndex(s => s.id === stageId);

  if (nextIdx <= prevIdx && stageId !== 'done') return;

  state.stage = stageId;
  state.days = stageObj ? stageObj.day : state.days + 1;
  state.stepsCompleted = nextIdx + 1;
  state.outcome = null;

  addLog('Stage advanced: ' + (stageObj ? stageObj.label : stageId), '#185fa5');

  const edu = STAGE_EDU[stageId] || {};
  const scenEdu = state.scenario && state.scenario.education[stageId];
  setEdu(edu.icon || '📋', edu.title || stageId, scenEdu || edu.text || '');

  renderProgressTracker();
  renderLanes();
  updateStats();
}

function handleDragStart(e) {
  state.dragCard = 'case-card';
  e.currentTarget.classList.add('dragging');
  e.dataTransfer.effectAllowed = 'move';
}

function handleDragEnd(e) {
  e.currentTarget.classList.remove('dragging');
  document.querySelectorAll('.lane-body').forEach(b => b.classList.remove('drag-over'));
}

function handleDragOver(e, lane) {
  e.preventDefault();
  e.dataTransfer.dropEffect = 'move';
  const body = document.getElementById('lane-body-' + lane);
  if (body) body.classList.add('drag-over');
}

function handleDragLeave(e, lane) {
  const body = document.getElementById('lane-body-' + lane);
  if (body) body.classList.remove('drag-over');
}

function handleDrop(e, lane) {
  e.preventDefault();
  document.querySelectorAll('.lane-body').forEach(b => b.classList.remove('drag-over'));
  if (!state.dragCard || !state.scenario) return;

  const stageOrder = WORKFLOW_STAGES.map(s => s.id);
  const currentIdx = stageOrder.indexOf(state.stage);
  const laneStages = { patient: ['intake','done'], provider: ['necessity','docs'], payer: ['submitted','review'] };
  const validTargets = laneStages[lane] || [];

  let nextStage = null;
  for (const vs of validTargets) {
    const vsIdx = stageOrder.indexOf(vs);
    if (vsIdx > currentIdx) { nextStage = vs; break; }
    if (vsIdx === currentIdx) { nextStage = vs; break; }
  }

  if (nextStage && nextStage !== state.stage) {
    addLog('Card dragged to ' + lane + ' lane', '#888');
    state.score = Math.max(0, state.score - 1);
    advanceToStage(nextStage);
  } else if (nextStage && nextStage === state.stage) {
    setEdu('ℹ️', 'Already Here', 'This case is already in the ' + lane + ' lane at this stage. Use the action buttons on the card to proceed.');
  } else {
    setEdu('⚠️', 'Invalid Move', 'Cases follow the PA workflow order: Patient → Provider → Payer → Provider/Patient. You cannot move backwards in the workflow.');
  }

  state.dragCard = null;
}

function showModal(title, body, actions) {
  document.getElementById('modal-title').innerHTML = title;
  document.getElementById('modal-body').innerHTML = body;
  const actWrap = document.getElementById('modal-actions');
  actWrap.innerHTML = '';
  (actions || []).forEach(a => {
    const btn = document.createElement('button');
    btn.className = 'btn ' + a.cls;
    btn.textContent = a.label;
    btn.onclick = a.fn;
    actWrap.appendChild(btn);
  });
  const cancelBtn = document.createElement('button');
  cancelBtn.className = 'btn btn-secondary';
  cancelBtn.textContent = 'Close';
  cancelBtn.onclick = closeModal;
  actWrap.appendChild(cancelBtn);
  document.getElementById('modal-overlay').classList.add('show');
}

function closeModal() {
  document.getElementById('modal-overlay').classList.remove('show');
}

function setEdu(icon, title, text) {
  document.getElementById('edu-panel').innerHTML =
    `<h3><span class="edu-icon">${icon}</span> ${title}</h3><p>${text}</p>`;
}

function showEdu(key) {
  if (key === 'welcome') {
    setEdu('📚', 'Welcome to the PA Simulator', 'Prior Authorization (PA) is a cost-control process used by health insurers requiring providers to obtain approval before delivering certain services. Select a scenario above, then follow the workflow steps. Every action teaches you about the real-world PA process.');
    return;
  }
  const stageEdu = STAGE_EDU[key];
  if (stageEdu) setEdu(stageEdu.icon, stageEdu.title, stageEdu.text);
}

function updateStats() {
  document.getElementById('stat-days').textContent = state.days.toFixed(1).replace('.0','');
  document.getElementById('stat-score').textContent = Math.round(state.score);
  document.getElementById('stat-steps').textContent = Math.round(state.stepsCompleted) + ' / ' + state.totalSteps;
  document.getElementById('stat-stage').textContent = state.stage ? state.stage.replace(/-/g,' ').replace(/\b\w/g,c=>c.toUpperCase()) : '—';
  document.getElementById('stat-scenario').textContent = state.scenario ? state.scenario.name : 'None';
}

function addLog(text, color) {
  state.activityLog.push({ text, day: state.days, color: color || '#185fa5' });
}

function showSummary() {
  const panel = document.getElementById('summary-panel');
  panel.style.display = 'block';

  const scoreColor = state.score >= 80 ? '#1b5e20' : state.score >= 50 ? '#e65100' : '#b71c1c';
  const outLabel = state.outcome === 'approved' ? '✅ Approved' : state.outcome === 'denied' ? '❌ Denied' : state.outcome || 'Complete';

  document.getElementById('summary-grid').innerHTML = `
    <div class="summary-stat"><div class="s-label">Final Outcome</div><div class="s-value" style="font-size:16px;color:${state.outcome==='approved'?'#1b5e20':'#b71c1c'}">${outLabel}</div></div>
    <div class="summary-stat"><div class="s-label">Days Elapsed</div><div class="s-value">${Math.ceil(state.days)}</div></div>
    <div class="summary-stat"><div class="s-label">Efficiency Score</div><div class="s-value" style="color:${scoreColor}">${Math.round(state.score)}</div></div>
    <div class="summary-stat"><div class="s-label">Docs Collected</div><div class="s-value">${state.docsCollected.length} / ${state.scenario ? state.scenario.requiredDocs.length : '?'}</div></div>
    <div class="summary-stat"><div class="s-label">Scenario</div><div class="s-value" style="font-size:14px">${state.scenario ? state.scenario.name : '—'}</div></div>
  `;

  const logList = document.getElementById('summary-log-list');
  logList.innerHTML = '';
  state.activityLog.forEach(item => {
    const row = document.createElement('div');
    row.className = 'log-item';
    row.innerHTML = `
      <div class="log-dot" style="background:${item.color}"></div>
      <div class="log-text">${item.text}</div>
      <div class="log-time">Day ${Math.ceil(item.day)}</div>
    `;
    logList.appendChild(row);
  });

  panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function restartGame() {
  state = {
    scenario: null, stage: null, days: 0, score: 100,
    stepsCompleted: 0, totalSteps: 7,
    docsCollected: [], necessityFactorsMet: [],
    outcome: null, activityLog: [], dragCard: null,
    caseId: 'PA-' + Math.floor(Math.random()*90000+10000),
  };
  document.getElementById('summary-panel').style.display = 'none';
  renderScenarioPills();
  renderProgressTracker();
  clearLanes();
  updateStats();
  showEdu('welcome');
}

function celebrate() {
  const canvas = document.getElementById('confetti-canvas');
  const ctx = canvas.getContext('2d');
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;

  const colors = ['#185fa5','#378add','#85b7eb','#639922','#ba7517','#e24b4a','#ffffff'];
  const particles = Array.from({length: 90}, () => ({
    x: Math.random() * canvas.width,
    y: Math.random() * canvas.height - canvas.height,
    r: Math.random() * 7 + 3,
    d: Math.random() * 4 + 1,
    color: colors[Math.floor(Math.random() * colors.length)],
    tilt: Math.random() * 10 - 5,
    tiltSpeed: Math.random() * 0.1 + 0.05,
    angle: 0,
  }));

  let frame = 0;
  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    particles.forEach(p => {
      ctx.beginPath();
      ctx.lineWidth = p.r / 2;
      ctx.strokeStyle = p.color;
      ctx.fillStyle = p.color;
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate((p.angle * Math.PI) / 180);
      ctx.fillRect(-p.r/2, -p.r/2, p.r, p.r * 2.5);
      ctx.restore();
      p.y += p.d + Math.sin(p.angle) * 2;
      p.angle += p.tiltSpeed * 10;
      p.x += Math.sin(frame / 20) * 1.5;
      if (p.y > canvas.height) { p.y = -10; p.x = Math.random() * canvas.width; }
    });
    frame++;
    if (frame < 160) requestAnimationFrame(draw);
    else ctx.clearRect(0, 0, canvas.width, canvas.height);
  }
  draw();
}

